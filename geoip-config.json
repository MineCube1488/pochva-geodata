{
  "input": [
    {
      "type": "dbipCountryMMDB",
      "action": "add",
      "args": {
        "uri": "./db-ip/dbip-country-lite.mmdb"
      }
    },
    {
      "type": "private",
      "action": "add"
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "steam-ip",
        "uri": "./steam-ip.txt"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "riot-ip",
        "uri": "./riot-ip.txt"
      }
    }
  ],
  "output": [
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "../output",
        "outputName": "geoip.dat",
        "wantedList": ["ru", "private", "steam-ip", "riot-ip"]
      }
    }
  ]
}
